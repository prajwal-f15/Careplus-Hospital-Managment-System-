{
  "version": 2,
  "public": true,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self)"
        }
      ]
    }
  ],
  "routes": [
    { "src": "/patient/?$", "dest": "/patient/index.html" },
    { "src": "/doctor/?$", "dest": "/doctor/index.html" },
    { "src": "/admin/?$", "dest": "/admin/index.html" }
  ]
}
