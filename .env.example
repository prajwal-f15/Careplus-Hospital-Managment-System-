# ==============================================================================
# CAREPULSE HOSPITAL MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env or configure in hosting platform (Vercel / Netlify)

# 1. Supabase Project URL (Public REST & Realtime Endpoint)
SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Anon / Public Key (Safe for frontend browser usage)
SUPABASE_ANON_KEY=your-anon-public-key-here

# 3. Environment & Deployment Mode
NODE_ENV=production
PORT=5500

# IMPORTANT SECURITY NOTE:
# NEVER expose or paste the SUPABASE_SERVICE_ROLE_KEY in frontend code or .env files.

